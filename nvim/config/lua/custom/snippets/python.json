{
  "ROS 2 Python Node": {
    "prefix": "rosnode",
    "body": [
      "import rclpy",
      "from rclpy.node import Node",
      "",
      "class ${1:MyNode}(Node):",
      "    def __init__(self):",
      "        super().__init__('${2:my_node_name}')",
      "        self.get_logger().info('Node initialized.')",
      "        ${3:# self.timer = self.create_timer(0.5, self.timer_callback)}",
      "",
      "    ${4:def timer_callback(self):}",
      "        ${5:pass}",
      "",
      "def main(args=None):",
      "    rclpy.init(args=args)",
      "    node = ${1:MyNode}()",
      "    try:",
      "        rclpy.spin(node)",
      "    except KeyboardInterrupt:",
      "        pass",
      "    finally:",
      "        node.destroy_node()",
      "        if rclpy.ok():",
      "            rclpy.shutdown()",
      "",
      "if __name__ == '__main__':",
      "    main()"
    ],
    "description": "Template for a standard ROS 2 Python Node"
  }
}