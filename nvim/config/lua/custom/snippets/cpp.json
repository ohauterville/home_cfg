{
  "ROS 2 C++ Node": {
    "prefix": "rosnode",
    "body": [
      "#include \"rclcpp/rclcpp.hpp\"",
      "",
      "class ${1:MyNode} : public rclcpp::Node",
      "{",
      "public:",
      "  ${1:MyNode}() : Node(\"${2:my_node_name}\")",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Node %s initialized.\", this->get_name());",
      "    ${3:// timer_ = this->create_wall_timer(std::chrono::milliseconds(500), std::bind(&${1:MyNode}::timer_callback, this));}",
      "  }",
      "",
      "private:",
      "  ${4:// void timer_callback() {}}",
      "};",
      "",
      "int main(int argc, char * argv[])",
      "{",
      "  rclcpp::init(argc, argv);",
      "  rclcpp::spin(std::make_shared<${1:MyNode}>());",
      "  rclcpp::shutdown();",
      "  return 0;",
      "}"
    ],
    "description": "Template for a standard ROS 2 C++ Node"
  },
  "ROS 2 Lifecycle Node": {
    "prefix": "roslifecycle",
    "body": [
      "#include \"rclcpp/rclcpp.hpp\"",
      "#include \"rclcpp_lifecycle/lifecycle_node.hpp\"",
      "",
      "using CallbackReturn = rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn;",
      "",
      "class ${1:MyLifecycleNode} : public rclcpp_lifecycle::LifecycleNode",
      "{",
      "public:",
      "  ${1:MyLifecycleNode}() : LifecycleNode(\"${2:my_lifecycle_node}\")",
      "  {}",
      "",
      "  CallbackReturn on_configure(const rclcpp_lifecycle::State &) override",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Configuring...\");",
      "    ${3:// Setup publishers, subscribers, params here}",
      "    return CallbackReturn::SUCCESS;",
      "  }",
      "",
      "  CallbackReturn on_activate(const rclcpp_lifecycle::State &) override",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Activating...\");",
      "    return CallbackReturn::SUCCESS;",
      "  }",
      "",
      "  CallbackReturn on_deactivate(const rclcpp_lifecycle::State &) override",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Deactivating...\");",
      "    return CallbackReturn::SUCCESS;",
      "  }",
      "",
      "  CallbackReturn on_cleanup(const rclcpp_lifecycle::State &) override",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Cleaning up...\");",
      "    return CallbackReturn::SUCCESS;",
      "  }",
      "",
      "  CallbackReturn on_shutdown(const rclcpp_lifecycle::State &) override",
      "  {",
      "    RCLCPP_INFO(this->get_logger(), \"Shutting down...\");",
      "    return CallbackReturn::SUCCESS;",
      "  }",
      "};",
      "",
      "int main(int argc, char * argv[])",
      "{",
      "  rclcpp::init(argc, argv);",
      "  rclcpp::spin(std::make_shared<${1:MyLifecycleNode}>()->get_node_base_interface());",
      "  rclcpp::shutdown();",
      "  return 0;",
      "}"
    ],
    "description": "Template for a ROS 2 Lifecycle C++ Node"
  }
}