[global_config]
[keybindings]
[profiles]
  [[default]]
    cursor_color = "#aaaaaa"
    font = JetBrainsMono Nerd Font 11
    scrollback_infinite = True
    use_system_font = False
    custom_command = tmux new-session -A -s main
  [[classic]]
    cursor_color = "#aaaaaa"
    font = JetBrainsMono Nerd Font 11
    scrollback_infinite = True
    use_custom_command = True
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[child1]]]
      type = Terminal
      parent = window0
    [[[window0]]]
      type = Window
[plugins]
