[global_config]
  always_split_with_profile = True
[keybindings]
[profiles]
  [[default]]
    cursor_color = "#aaaaaa"
    font = JetBrainsMono Nerd Font 11
    show_titlebar = True
    scrollback_infinite = True
    use_system_font = False
    copy_on_selection = True
    background_type = transparent
    background_darkness = 0.85
[layouts]
  [[default]]
    [[[child1]]]
      type = Terminal
      parent = window0
    [[[window0]]]
      type = Window
[plugins]
